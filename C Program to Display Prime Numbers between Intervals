#include <stdio.h>
#include <stdbool.h>

int main() {
    int lower, upper, i, j;
    bool isPrime;

    printf("Enter lower and upper interval: ");
    scanf("%d %d", &lower, &upper);

    printf("Prime numbers between %d and %d are:\n", lower, upper);

    for (i = lower; i <= upper; i++) {
        if (i <= 1) continue;

        isPrime = true;

        for (j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = false;
                break;
            }
        }

        if (isPrime) {
            printf("%d ", i);
        }
    }

    printf("\n");
    return 0;
}
